{
  "slug": "process-mining",
  "title": "流程事件日期与处理时长预检",
  "fields": [
    {
      "key": "event_no",
      "label": "事件号",
      "type": "ID",
      "length": 200
    },
    {
      "key": "case_no",
      "label": "实例号",
      "type": "ID",
      "length": 200
    },
    {
      "key": "activity",
      "label": "活动",
      "type": "TEXT",
      "length": 200
    },
    {
      "key": "start_date",
      "label": "开始日期",
      "type": "DATE",
      "length": 200
    },
    {
      "key": "end_date",
      "label": "结束日期",
      "type": "DATE",
      "length": 200
    },
    {
      "key": "duration_minutes",
      "label": "处理分钟",
      "type": "INTEGER",
      "length": 200,
      "scale": 0,
      "max": "525600"
    }
  ],
  "unique": [
    [
      "event_no"
    ]
  ],
  "rules": [
    {
      "op": "DATE_LE",
      "args": [
        "start_date",
        "end_date"
      ],
      "code": "EVENT_DATE",
      "message": "结束日期不能早于开始日期",
      "bad": {
        "end_date": "2026-09-30"
      }
    }
  ],
  "sampleCsv": "event_no,case_no,activity,start_date,end_date,duration_minutes\nEVT-001,CASE-01,示例审批,2026-10-01,2026-10-02,480\n",
  "limits": {
    "rows": 500,
    "bytes": 262144,
    "columns": 32,
    "cellCharacters": 4000
  },
  "scope": "Read-only batch validation; no persistence, reference-master lookup or full production certification."
}
